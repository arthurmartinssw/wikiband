{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://itunes.apple.com; media-src 'self' https: blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/favoritos.html",
      "destination": "/favoritos",
      "permanent": true
    },
    {
      "source": "/banda.html",
      "destination": "/banda",
      "permanent": true
    },
    {
      "source": "/sobre.html",
      "destination": "/sobre",
      "permanent": true
    },
    {
      "source": "/perfil.html",
      "destination": "/perfil",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/proxy?path=health"
    },
    {
      "source": "/api/auth/login",
      "destination": "/api/proxy?path=auth/login"
    },
    {
      "source": "/api/auth/register",
      "destination": "/api/proxy?path=auth/register"
    },
    {
      "source": "/api/auth/profile",
      "destination": "/api/proxy?path=auth/profile"
    },
    {
      "source": "/api/itunes/search",
      "destination": "/api/proxy?path=itunes/search"
    },
    {
      "source": "/api/itunes/lookup",
      "destination": "/api/proxy?path=itunes/lookup"
    }
  ]
}
