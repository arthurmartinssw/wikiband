{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/favoritos.html",
      "destination": "/favoritos",
      "permanent": true
    },
    {
      "source": "/banda.html",
      "destination": "/banda",
      "permanent": true
    },
    {
      "source": "/sobre.html",
      "destination": "/sobre",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://poems-sweet-affiliate-porcelain.trycloudflare.com/api/:path*"
    }
  ]
}
