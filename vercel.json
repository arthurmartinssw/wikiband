{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/favoritos.html",
      "destination": "/favoritos",
      "permanent": true
    },
    {
      "source": "/banda.html",
      "destination": "/banda",
      "permanent": true
    },
    {
      "source": "/sobre.html",
      "destination": "/sobre",
      "permanent": true
    },
    {
      "source": "/perfil.html",
      "destination": "/perfil",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/proxy?path=health"
    },
    {
      "source": "/api/auth/login",
      "destination": "/api/proxy?path=auth/login"
    },
    {
      "source": "/api/auth/register",
      "destination": "/api/proxy?path=auth/register"
    },
    {
      "source": "/api/auth/profile",
      "destination": "/api/proxy?path=auth/profile"
    },
    {
      "source": "/api/itunes/search",
      "destination": "/api/proxy?path=itunes/search"
    },
    {
      "source": "/api/itunes/lookup",
      "destination": "/api/proxy?path=itunes/lookup"
    }
  ]
}
