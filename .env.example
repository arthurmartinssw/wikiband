PORT=3000

# Producao barata com Neon/Postgres
DB_CLIENT=postgres
DATABASE_URL=postgresql://usuario:senha@host/db?sslmode=require
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
SESSION_SECRET=troque_por_uma_frase_longa_e_aleatoria_com_32_chars_ou_mais
CORS_ORIGINS=https://wikiband.vercel.app

# Mesmo valor no backend e na Vercel: permite ao proxy repassar o IP real do usuario para o rate limit.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PROXY_SHARED_SECRET=troque_por_um_segredo_aleatorio_longo

# Vercel
WIKIBAND_API_ORIGIN=https://wikiband-api.seu-dominio.com

# MusicAI (Vercel). Groq e o padrao; para trocar de IA basta mudar estas variaveis.
# AI_PROVIDER: groq | openai | gemini | openrouter | custom (qualquer API compativel com OpenAI)
AI_PROVIDER=groq
GROQ_API_KEY=sua_chave_groq
# AI_API_KEY=chave_do_provedor_escolhido
# AI_MODEL=obrigatorio_para_provedores_diferentes_de_groq
# AI_BASE_URL=so_para_custom_ex_http://localhost:11434/v1
